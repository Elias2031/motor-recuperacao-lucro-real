# Copie para .env e preencha. Todas as variáveis são opcionais: sem elas o
# motor usa placeholders neutros (o SPED gerado não passará no PVA sem dados reais).

# Registro 0100 - dados do contabilista responsável pelo SPED gerado
CONTABILISTA_NOME=NOME DO CONTABILISTA
CONTABILISTA_CPF=00000000000
CONTABILISTA_CRC=000000O
CONTABILISTA_CNPJ=
CONTABILISTA_CEP=00000000
CONTABILISTA_ENDERECO=ENDERECO DO CONTABILISTA
CONTABILISTA_NUMERO=
CONTABILISTA_COMPLEMENTO=
CONTABILISTA_BAIRRO=BAIRRO
CONTABILISTA_TELEFONE=
CONTABILISTA_FAX=
CONTABILISTA_EMAIL=contato@exemplo.com.br
CONTABILISTA_COD_MUNICIPIO=5300108

# Emitente padrão (usado só quando o período não tem nota de saída;
# com notas de saída os dados vêm do próprio XML)
EMITENTE_RAZAO_SOCIAL=EMPRESA EXEMPLO LTDA
EMITENTE_NOME_FANTASIA=EMPRESA EXEMPLO
EMITENTE_IE=
EMITENTE_UF=DF
EMITENTE_COD_MUNICIPIO=5300108
EMITENTE_CNPJ=00000000000000
EMITENTE_CEP=00000000
EMITENTE_LOGRADOURO=ENDERECO
EMITENTE_NUMERO=S/N
EMITENTE_BAIRRO=BAIRRO
EMITENTE_TELEFONE=

# CPF do participante "CONSUMIDOR FINAL PADRAO" injetado no 0150 do SPED Fiscal
CONSUMIDOR_PADRAO_CPF=00000000000
